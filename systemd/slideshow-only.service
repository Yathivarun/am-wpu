# TEMPLATE — do not install this file directly.
# scripts/setup.sh substitutes @APP_DIR@ / @RUN_USER@ / @DISPLAY_ENV@ with the
# values detected on the device and writes the result to /etc/systemd/system/.

[Unit]
Description=WPU slideshow — display only (stock images/videos, no recognition)
Conflicts=slideshow-server.service slideshow-diagnostic.service

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@APP_DIR@
@DISPLAY_ENV@
# --service slideshow starts the display and nothing else: no camera is
# opened, no models are loaded, no server is contacted. Use it for a unit
# that is only ever a screen, or to keep something on the display while the
# camera is needed elsewhere (seeding, benchmarks, a manual run).
ExecStart=@APP_DIR@/.venv/bin/python main.py --service slideshow
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
