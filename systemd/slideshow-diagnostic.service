# PENDING ON-DEVICE CONFIRMATION (CLEANUP_PLAN.md UNCERTAIN #5) — see
# slideshow-server.service for the full list of placeholders to verify
# (folder name, display server, XDG_RUNTIME_DIR uid, linger).

[Unit]
Description=WPU slideshow — diagnostic mode (local recognition, 3 seeded people)
Conflicts=slideshow-server.service

[Service]
Type=simple
User=dreamvu
WorkingDirectory=/home/dreamvu/wpu_client
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/dreamvu/wpu_client/.venv/bin/python main.py --service all --diagnostic
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
