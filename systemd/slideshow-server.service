# TEMPLATE — do not install this file directly.
# scripts/setup.sh substitutes @APP_DIR@ / @RUN_USER@ / @DISPLAY_ENV@ with the
# values detected on the device and writes the result to /etc/systemd/system/.

[Unit]
Description=WPU slideshow — server mode (online recognition + slideshow)
After=network-online.target
Wants=network-online.target
Conflicts=slideshow-diagnostic.service slideshow-only.service

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@APP_DIR@
@DISPLAY_ENV@
ExecStart=@APP_DIR@/.venv/bin/python main.py --service all
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
