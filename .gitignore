# Python
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtualenvs / tooling
.venv/
venv/
env/
ENV/
.python-version

# Secrets & local config
.env
.env.*
config/config.local.yaml
# Per-device config, generated by setup.sh from config.yaml.example. Tracking it
# shipped one developer's live cluster IP and research model settings to every Pi.
config/config.yaml

# Working notes — point-in-time scratch, not documentation. README.md is the
# tracked doc; these go stale the moment the tree moves under them.
CLEANUP_PLAN.md
CODEBASE_SUMMARY.md

# Logs
*.log
/var/log/wpu-client/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude
.claude/

# Testing / coverage
.coverage
.pytest_cache/
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.temp

# Runtime capture & benchmarks (never shipped)
dataset/
data/dataset/
benchmark_output/
data-alloy/
embedding_logs/
passport_photo.jpeg

# Archived diagnostic people (kept locally, never shipped, not tracked)
archive/

# Duo scene composition cache — generated per-pair from data/duo_scenes/ +
# each person's alpha image, reproducible, never shipped.
data/duo_output/

# Model weights: ignore all .onnx by default, but TRACK the three runtime
# models under models/ (~45 MB total, incl. SFace kept for v1) — keeps the
# git tree self-contained so make_release.sh = archive of tracked files.
*.onnx
!models/mobilefacenet.onnx
!models/face_recognition_sface_2021dec.onnx
!models/face_detection_yunet_2023mar.onnx

# Diagnostic gallery: track ONLY the three seeded people; ignore any other seeds/local dumps
data/embeddings/*
!data/embeddings/varun/
!data/embeddings/samvaran/
!data/embeddings/kevin/
data/people/*
!data/people/Varun.png
!data/people/Samvaran.png
!data/people/Kevin.png
